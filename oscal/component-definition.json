        "type": "software",
        "title": "kubernetes-air-gapped-ai-agent v1.8.0 admission policies",
        "description": "The admission policies of heyvaldemar/kubernetes-air-gapped-ai-agent at release v1.8.0, read from its signed source archive: Kyverno's verify-models and four Kubernetes ValidatingAdmissionPolicies.",
        "props": [
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "verify-models",
            "remarks": "rule_set_0"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Model weights are mounted only from the registry inside the boundary, by digest, signed with the operator's key, with an AI-BOM attested with the same key whose every licence is one the site allows.",
            "remarks": "rule_set_0"
          },
          {
            "name": "policy-file",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "admission/verify-models.yaml",
            "remarks": "rule_set_0"
          },
          {
            "name": "policy-kind",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "Kyverno ImageValidatingPolicy",
            "remarks": "rule_set_0"
          },
          {
            "name": "posture",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "kyverno",
            "remarks": "rule_set_0"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "model-volumes",
            "remarks": "rule_set_1"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "An image volume in a namespace for verified models names an image under the registry's models path, by digest, checked by the API server itself, so the rule holds while Kyverno is down.",
            "remarks": "rule_set_1"
          },
          {
            "name": "policy-file",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "admission/model-volumes.yaml",
            "remarks": "rule_set_1"
          },
          {
            "name": "policy-kind",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "Kubernetes ValidatingAdmissionPolicy",
            "remarks": "rule_set_1"
          },
          {
            "name": "posture",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "kyverno",
            "remarks": "rule_set_1"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "carried-images",
            "remarks": "rule_set_2"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Every image a pod uses (containers, init and ephemeral containers, image volumes) is named by digest, and the digest is one the signed bundle carried; kube-system and local-path-storage excepted.",
            "remarks": "rule_set_2"
          },
          {
            "name": "policy-file",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "admission/carried-images.yaml",
            "remarks": "rule_set_2"
          },
          {
            "name": "policy-kind",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "Kubernetes ValidatingAdmissionPolicy",
            "remarks": "rule_set_2"
          },
          {
            "name": "posture",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "kyverno",
            "remarks": "rule_set_2"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "models-need-kyverno",
            "remarks": "rule_set_3"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "No model is mounted while Kyverno's webhook for verify-models is missing or no longer fails closed.",
            "remarks": "rule_set_3"
          },
          {
            "name": "policy-file",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "admission/kyverno-guard.yaml",
            "remarks": "rule_set_3"
          },
          {
            "name": "policy-kind",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "Kubernetes ValidatingAdmissionPolicy",
            "remarks": "rule_set_3"
          },
          {
            "name": "posture",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "kyverno",
            "remarks": "rule_set_3"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "egress-node",
            "remarks": "rule_set_4"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
            "value": "Only the gateway runs on the egress node: a pod outside its namespace may not tolerate the node's taint, tolerate every taint, or name a node when it is created.",
            "remarks": "rule_set_4"
          },
          {
            "name": "policy-file",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "admission/egress-node.yaml",
            "remarks": "rule_set_4"
          },
          {
            "name": "policy-kind",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "Kubernetes ValidatingAdmissionPolicy",
            "remarks": "rule_set_4"
          },
          {
            "name": "posture",
            "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
            "value": "none",
            "remarks": "rule_set_4"
          }
        ],
        "control-implementations": [
          {
            "uuid": "ad2b1445-057b-5b7f-88d9-2ed60ee8bdaf",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/f0de6d8d8c059d374f15e0ae07508d82e370fc1d/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "description": "NIST SP 800-53 Rev. 5.2.0",
            "props": [
              {
                "name": "Framework_Short_Name",
                "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal",
                "value": "nist_800_53"
              }
            ],
            "implemented-requirements": [
              {
                "uuid": "64383010-fd11-5af5-a6aa-62854c772e0d",
                "control-id": "cm-14",
                "description": "A pod in a namespace for verified models mounts model weights only if the image's signature verifies with the operator's public key; Kyverno checks it at admission.",
                "props": [
                  {
                    "name": "Rule_Id",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
                    "value": "verify-models"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-unsigned"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-stranger"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-signed"
                  }
                ],
                "remarks": "Not covered: Model weights only: container images are held to a list of digests (CM-7(5)), not to signatures. The operator's key is a public key written into the policy, with no certificate and no transparency log."
              },
              {
                "uuid": "ab912471-4d28-5aa0-99ad-77f808ccee16",
                "control-id": "si-7",
                "description": "A model image is named by its digest, so a changed image is a different name, and its signature is verified before it is mounted; a model that fails either is refused.",
                "props": [
                  {
                    "name": "Rule_Id",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
                    "value": "model-volumes"
                  },
                  {
                    "name": "Rule_Id",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
                    "value": "verify-models"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "volume-elsewhere"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-unsigned"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-stranger"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-signed"
                  }
                ],
                "remarks": "Not covered: Checked when a pod is admitted. The flagship's policy does not check running pods again; here Kyverno re-reads them for its reports, which records and refuses nothing."
              },
              {
                "uuid": "316c8116-d819-5e90-a91d-3fb7e58df60a",
                "control-id": "sr-4",
                "description": "A model is mounted only with an AI-BOM attested with the operator's key: what the model is, where its file came from at which revision, and its sha256.",
                "props": [
                  {
                    "name": "Rule_Id",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
                    "value": "verify-models"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-nobom"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-signed"
                  }
                ],
                "remarks": "Not covered: Admission checks that the provenance record is there and signed, not that it is true of the source. Container images carry no provenance check here."
              },
              {
                "uuid": "ed7b6741-a1b7-519d-9001-40838deada00",
                "control-id": "sr-11",
                "description": "An image the signed bundle did not carry is refused, whoever made the pod and however the image reached the cluster: containers, init and ephemeral containers, and image volumes.",
                "props": [
                  {
                    "name": "Rule_Id",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
                    "value": "carried-images"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "image-not-carried"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "volume-not-carried"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "ordinary-pod"
                  }
                ],
                "remarks": "Not covered: Part (b), reporting counterfeit components to anyone, is not done. kube-system and local-path-storage are exempt: their images come with the node image."
              },
              {
                "uuid": "bf2023c8-b46e-59bd-ab5a-2455a7ebe3be",
                "control-id": "cm-7.5",
                "description": "Deny-all, permit-by-exception: the exceptions are the digests the signed bundle carried, the policy's parameter. An image named by tag alone is refused.",
                "props": [
                  {
                    "name": "Rule_Id",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
                    "value": "carried-images"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "image-by-tag"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "image-not-carried"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "ordinary-pod"
                  }
                ],
                "remarks": "Not covered: Part (c), reviewing the list of authorized software, is a person's work. kube-system and local-path-storage are exempt."
              },
              {
                "uuid": "e41a07ca-95cc-54ec-95ba-1e77acdf7ee7",
                "control-id": "sc-24",
                "description": "With Kyverno's admission controller at zero replicas and its webhook gone, the API server's own policy refuses every model mount: the failure is an outage, not an open door.",
                "props": [
                  {
                    "name": "Rule_Id",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
                    "value": "models-need-kyverno"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "kyverno-away"
                  }
                ],
                "remarks": "Not covered: Model mounts only. Other pods are admitted while Kyverno is away; their images are still held to the bundle by carried-images, which needs no Kyverno."
              },
              {
                "uuid": "223a0480-2403-55d6-82b1-6c3f08a8369e",
                "control-id": "ac-6",
                "description": "Only the gateway may run on the one node with a way out of the cluster: a pod elsewhere may not tolerate that node's taint, tolerate every taint, or name the node and skip the scheduler.",
                "props": [
                  {
                    "name": "Rule_Id",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
                    "value": "egress-node"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "egress-toleration"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "egress-tolerate-all"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "egress-node-name"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "ordinary-pod"
                  }
                ],
                "remarks": "Not covered: Where pods run, not what they may do there. Judged by admission tests alone: Kyverno's reports cannot judge this policy (rules.egress-node.why)."
              }
            ]
          },
          {
            "uuid": "7a500e43-b6f8-5d38-ac23-7ec5825d7df0",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/f0de6d8d8c059d374f15e0ae07508d82e370fc1d/nist.gov/SP800-218/ver1/json/NIST_SP800-218_ver1_catalog.json",
            "description": "NIST SP 800-218 SSDF v1.1",
            "props": [
              {
