                "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal",
                "value": "nist_ssdf"
              }
            ],
            "implemented-requirements": [
              {
                "uuid": "a8953b28-2632-5ba0-a5b2-8d47140e2f4d",
                "control-id": "PW.4.4",
                "description": "Every model a pod mounts has an AI-BOM in which every model declares only licences the site allows (Apache-2.0, MIT), named by SPDX id; checked at admission.",
                "props": [
                  {
                    "name": "Rule_Id",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
                    "value": "verify-models"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-unlicensed"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-licence-mixed"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-licence-second"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-licence-expression"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-licence-concluded"
                  }
                ],
                "remarks": "Not covered: Licence, signature and provenance record only: no check for known vulnerabilities in the model or in the server that loads it."
              }
            ]
          },
          {
            "uuid": "536bcfc4-a2e4-5f25-b8ed-76d2e51931df",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/f0de6d8d8c059d374f15e0ae07508d82e370fc1d/nist.gov/AI100-1/ver1/json/NIST_AI-RMF_v1_catalog.json",
