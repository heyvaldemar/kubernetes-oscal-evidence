            "props": [
              {
                "name": "Framework_Short_Name",
                "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal",
                "value": "nist_ai_rmf"
              }
            ],
            "implemented-requirements": [
              {
                "uuid": "bdf7cbce-d88d-534d-84ca-022bca437aa7",
                "control-id": "MANAGE_3.1",
                "description": "Third-party models are held to risk controls where they are used: signed by the operator, with an attested AI-BOM, under a licence the site allows; each refusal names the rule it broke.",
                "props": [
                  {
                    "name": "Rule_Id",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd",
                    "value": "verify-models"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-unsigned"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-nobom"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-unlicensed"
                  },
                  {
                    "name": "proven-by",
                    "ns": "https://github.com/heyvaldemar/kubernetes-oscal-evidence/ns",
                    "value": "model-signed"
                  }
                ],
                "remarks": "Not covered: Applied and recorded at admission, not monitored over time; the benefits and performance of a third-party model are not assessed here."
              }
            ]
          }
        ]
      },
